APP_NAME="Shri Kamadgiri Peetham Sewa Trust"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Asia/Kolkata
APP_URL=https://your-domain.com

APP_LOCALE=hi
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=hi_IN

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# Hostinger MySQL Database Settings
# Locate these values in Hostinger hPanel -> Databases -> MySQL Databases
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=u123456789_kamadgiri
DB_USERNAME=u123456789_dbuser
DB_PASSWORD="your-strong-database-password"

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

# Hostinger SMTP Configuration (hPanel -> Emails -> Email Accounts)
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_USERNAME=noreply@your-domain.com
MAIL_PASSWORD="your-email-password"
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS="noreply@your-domain.com"
MAIL_FROM_NAME="Shri Kamadgiri Peetham Sewa Trust"

# Razorpay Payment Gateway (Live or Test credentials)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Vite Application Name
VITE_APP_NAME="${APP_NAME}"
